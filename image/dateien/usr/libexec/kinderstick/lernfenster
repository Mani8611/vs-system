#!/usr/bin/python3
"""Kinder-Stick – Lernfenster.

Zeigt eine freigegebene Lern-Webseite (z. B. ANTON) in einem eigenen Fenster mit großem
„Fertig“-Knopf. Navigation ist nur zu den erlaubten Domains möglich, alles andere wird
ignoriert. Anmeldedaten (Cookies) bleiben im Kinderkonto gespeichert.

Aufruf: lernfenster --titel ANTON --start https://anton.app/de/ --erlaubt anton.app[,weitere.at]
"""
import argparse
import os
import sys
from urllib.parse import urlparse

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("WebKit", "6.0")
from gi.repository import Gio, Gtk, WebKit  # noqa: E402

sys.path.insert(0, "/usr/lib/kinderstick")
import kopfleiste  # noqa: E402  (gemeinsame Kopfleiste mit Fertig-Knopf, Restzeit, Einklappen)


FEHLERSEITE = """<!doctype html><html lang="de"><meta charset="utf-8">
<body style="font-family:Cantarell,sans-serif;background:#EEF5F0;color:#1B4332;display:flex;
flex-direction:column;align-items:center;justify-content:center;height:100vh;margin:0;text-align:center">
<div style="font-size:120px">📶</div>
<h1 style="font-size:40px;margin:16px 0 8px">Kein Internet</h1>
<p style="font-size:24px;max-width:700px">Dieses Programm braucht Internet.<br>
Bitte Mama oder Papa: im Eltern-Bereich (Schloss unten rechts) das WLAN verbinden.</p>
<p style="font-size:20px;color:#5C6B73">Tippe oben links auf „Fertig“.</p>
</body></html>"""


def domain_erlaubt(uri, domains):
    """True, wenn die Adresse https ist und zu einer erlaubten Domain gehört."""
    if uri in ("about:blank", ""):
        return True
    teile = urlparse(uri)
    if teile.scheme != "https":
        return False
    host = (teile.hostname or "").lower()
    return any(host == d or host.endswith("." + d) for d in domains)


class Lernfenster(Gtk.Application):
    def __init__(self, args):
        super().__init__(application_id="at.kinderstick.Lernfenster",
                         flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.args = args
        self.domains = [d.strip().lower() for d in args.erlaubt.split(",") if d.strip()]

    def do_activate(self):
        kopfleiste.stil_laden()

        fenster = Gtk.ApplicationWindow(application=self, title=self.args.titel)
        # Knopf-Leiste im Inhalt, nicht in der Titelleiste: die blendet GTK im Vollbild aus
        # (Test 26.11.2026: bei ANTON kam man nicht mehr zurück)
        def klappen(ein):
            leiste.set_visible(not ein)
            lasche.set_visible(ein)
        leiste = kopfleiste.Kopfleiste(self.args.titel, fenster.close, klappen)
        lasche = kopfleiste.lasche(klappen)

        basis = os.path.expanduser("~/.local/share/kinderstick/lernfenster")
        cache = os.path.expanduser("~/.cache/kinderstick/lernfenster")
        sitzung = WebKit.NetworkSession.new(basis, cache)
        ansicht = WebKit.WebView(network_session=sitzung)
        ansicht.get_settings().set_enable_developer_extras(False)
        ansicht.connect("decide-policy", self.entscheiden)
        ansicht.connect("load-failed", self.laden_fehlgeschlagen)
        ansicht.load_uri(self.args.start)

        ansicht.set_vexpand(True)
        spalte = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        spalte.append(leiste)
        spalte.append(ansicht)
        # Eingeklappt liegt nur die Lasche oben in der Mitte über der Seite
        inhalt = Gtk.Overlay(child=spalte)
        inhalt.add_overlay(lasche)
        fenster.set_child(inhalt)
        fenster.fullscreen()
        fenster.present()

    def laden_fehlgeschlagen(self, ansicht, ereignis, uri, fehler):
        """Kindgerechte Meldung statt technischer Fehlerseite (z. B. kein WLAN)."""
        if fehler.matches(WebKit.network_error_quark(), WebKit.NetworkError.CANCELLED):
            return False
        ansicht.load_alternate_html(FEHLERSEITE, uri, None)
        return True

    def entscheiden(self, ansicht, entscheidung, typ):
        if typ in (WebKit.PolicyDecisionType.NAVIGATION_ACTION,
                   WebKit.PolicyDecisionType.NEW_WINDOW_ACTION):
            uri = entscheidung.get_navigation_action().get_request().get_uri()
            if not domain_erlaubt(uri, self.domains):
                entscheidung.ignore()
                return True
            if typ == WebKit.PolicyDecisionType.NEW_WINDOW_ACTION:
                # Neue Fenster im selben Fenster öffnen
                ansicht.load_uri(uri)
                entscheidung.ignore()
                return True
        return False


def main():
    p = argparse.ArgumentParser(description="Kinder-Stick Lernfenster")
    p.add_argument("--titel", required=True)
    p.add_argument("--start", required=True)
    p.add_argument("--erlaubt", required=True, help="Kommagetrennte Domains")
    args = p.parse_args()
    if not domain_erlaubt(args.start, [d.strip().lower() for d in args.erlaubt.split(",")]):
        print("Startadresse liegt nicht in den erlaubten Domains.", file=sys.stderr)
        return 1
    return Lernfenster(args).run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
