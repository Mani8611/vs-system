# Kinder-Stick – System-Image (bootc)
#
# Basis: offizielles Fedora-Silverblue-Image (GNOME, als bootfähiger Container).
# Fedora 45 (Herbst 2026) bringt GNOME 51 mit. Version bei Bedarf anheben (Release-Notizen prüfen).
#
# Bauen (im Hauptordner des Projekts, Linux mit Podman):
#   podman build -f image/Containerfile -t kinderstick:latest .
#
# Hinweis: Vor einer Weitergabe Fedora-Logos/-Namen durch eigene ersetzen
# (Fedora-Markenrichtlinien, siehe doku/technik-phase1.md, „Technisch offen“).

ARG FEDORA_VERSION=45
FROM quay.io/fedora-ostree-desktops/silverblue:${FEDORA_VERSION}

# Zusatzpakete:
#  - gnome-kiosk-script-session: Kiosk-Sitzung für das Kinderkonto
#  - gcompris-qt: Lernspiele (offline). Malen, Rechnen, Buchstaben und Merkspiel sind eigene
#    Programme der Oberfläche (oberflaeche/apps/). Tux Paint, Tux Math, Tux Typing, KLettres,
#    KTuberling, Blinken wurden nach dem Test am 26.11.2026 entfernt (nicht kindgerecht / ging nicht).
#    Vorlesen ist ausgeschaltet, daher kein speech-dispatcher/espeak-ng mehr.
#  - python3-gobject, python3-cairo, gtk4, webkitgtk6.0: Lernfenster (ANTON) und Kopfleiste über
#    Lernspielen/Netflix/Disney+ (cairo: eingeklappt nimmt die Leiste nur auf der Lasche Klicks an)
#  - glibc-langpack-de: deutsche Sprache
RUN dnf -y install \
        gnome-kiosk-script-session \
        gcompris-qt \
        python3-gobject \
        python3-cairo \
        gtk4 \
        webkitgtk6.0 \
        glibc-langpack-de \
    && dnf clean all

# Eigene Dateien: Systemkonfiguration, Dienst, Kinder-Oberfläche
COPY image/dateien/ /
COPY dienst/kinderstick_dienst.py dienst/hoeren.py /usr/lib/kinderstick/
COPY oberflaeche/ /usr/share/kinderstick/oberflaeche/

# Stick startet über den Standard-Pfad EFI/BOOT ohne Firmware-Eintrag (Erklärung im Skript)
COPY image/efi-direktstart.sh /tmp/efi-direktstart.sh
RUN bash /tmp/efi-direktstart.sh && rm -f /tmp/efi-direktstart.sh

RUN chmod 0755 /usr/libexec/kinderstick/* \
    && ln -sf ../usr/share/zoneinfo/Europe/Vienna /etc/localtime \
    && dconf update \
    && systemctl enable kinderstick-erststart.service kinderstick-dienst.service

# Prüft das Image auf typische bootc-Fehler
RUN bootc container lint
